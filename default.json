{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Shared Renovate preset for Giftpilz0 repositories",
  "extends": [
    "config:recommended",
    "group:allNonMajor",
    ":timezone(Europe/Berlin)",
    "schedule:weekly"
  ],
  "pre-commit": {
    "enabled": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Versions annotated with '# renovate: datasource=... depName=...' on the line above",
      "managerFilePatterns": [
        "/.+\\.ya?ml$/",
        "/(^|/)(Container|Docker)file$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>[^\\s]+)(?:\\s+registryUrl=(?<registryUrl>[^\\s]+))?(?:\\s+extractVersion=(?<extractVersion>[^\\s]+))?(?:\\s+versioning=(?<versioning>[^\\s]+))?\\n\\s*(?:[\\w_]+:\\s*|ARG \\w+=)[\"']?(?<currentValue>[^\\s\"'\\n#]+)[\"']?"
      ]
    }
  ]
}
